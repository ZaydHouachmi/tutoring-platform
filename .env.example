# Copy this file to .env.local and fill in the values from your Supabase
# project: Settings -> API.
#
# .env.local is gitignored. NEVER commit real keys.

# Project URL, e.g. https://abcdefgh.supabase.co
SUPABASE_URL=

# Secret key from Settings -> API Keys -> Secret keys (starts sb_secret_).
# NOT the publishable key. It bypasses every security rule, so it belongs only
# here and in Vercel's environment variables. Never in the browser, never in
# the repo, never in chat.
SUPABASE_SECRET_KEY=

# Resend (https://resend.com) sends you an email when a booking arrives.
# Without these the site still stores bookings, it just does not tell you.
RESEND_API_KEY=
# Where to send the notification. On Resend's free tier without your own
# domain, this must be the email you signed up with.
NOTIFY_EMAIL=
# Optional. Needs a domain verified in Resend; otherwise leave it unset and
# the default onboarding@resend.dev sender is used.
NOTIFY_FROM=
