# Copy this file to .env.local and fill in the values from your Supabase
# project: Settings -> API.
#
# .env.local is gitignored. NEVER commit real keys.

# Project URL, e.g. https://abcdefgh.supabase.co
SUPABASE_URL=

# Secret key from Settings -> API Keys -> Secret keys (starts sb_secret_).
# NOT the publishable key. It bypasses every security rule, so it belongs only
# here and in Vercel's environment variables. Never in the browser, never in
# the repo, never in chat.
SUPABASE_SECRET_KEY=
